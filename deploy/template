Deploy:
  Update:
    # Opt in to background checks and idle fast-forward updates of this fork.
    AutoUpdate: false
    # Minutes between checks; minimum 1 minute.
    CheckUpdateInterval: 5
    # Optional HH:MM; apply when idle at/after this time (China timezone).
    # null applies at the next idle check. Manual updates ignore this time.
    AutoRestartTime: null

  Adb:
    # Existing ADB used by device connections; startup does not install or replace it.
    AdbExecutable: ./toolkit/Lib/site-packages/adbutils/binaries/adb.exe

  Ocr:
    # Run OCR as a mandatory service. All OCR recognition goes through RPC.

    # Whether to start ocr server when start GUI
    # [Default] true
    StartOcrServer: true
    # Bind locally by default. Set 0.0.0.0 explicitly only for trusted remote clients.
    OcrServerHost: 127.0.0.1
    # Port of ocr server runs by GUI
    # [Default] 22268
    OcrServerPort: 22268
    # Address of ocr server for alas instance to connect
    # [Default] 127.0.0.1:22268
    OcrClientAddress: 127.0.0.1:22268
    # OCR server worker count, 0 means auto detect
    # [Default] 0
    OcrServerWorkerCount: 0

  Image:
    # Run image recognition as a service. This service is mandatory and all image rules use it.

    # Whether to auto start image server when startup
    # [Default] true
    StartImageServer: true
    # Bind locally by default. Set 0.0.0.0 explicitly only for trusted remote clients.
    ImageServerHost: 127.0.0.1
    # Port of image server
    # [Default] 22269
    ImageServerPort: 22269
    # Address of image server for script instances to connect
    # [Default] 127.0.0.1:22269
    ImageClientAddress: 127.0.0.1:22269
    # Template cache expire seconds
    # [Default] 3600
    ImageTemplateCacheExpireSeconds: 3600
    # Template cache max item count
    # [Default] 200
    ImageTemplateCacheMaxCount: 200
    # Frame cache expire seconds
    # [Default] 10.0
    ImageFrameCacheExpireSeconds: 10.0
    # Frame cache max item count
    # [Default] 66
    ImageFrameCacheMaxCount: 66
    # Image server worker count, 0 means auto detect
    # [Default] 0
    ImageServerWorkerCount: 0

  Misc:
    # Enable discord rich presence
    DiscordRichPresence: false

  RemoteAccess:
    # Enable remote access (using ssh reverse tunnel serve by https://github.com/wang0618/localshare)
    # ! You need to set Password below to enable remote access since everyone can access to your alas if they have your url.
    # See here (http://app.azurlane.cloud/en.html) for more infomation.
    EnableRemoteAccess: false
    # Username when login into ssh server
    # [Default] null (will generate a random one when startup)
    SSHUser: null
    # Server to connect
    # [Default] null
    # [Format] host:port
    SSHServer: null
    # Filepath of SSH executable `ssh.exe`
    # [Default] ssh (find ssh in system PATH)
    # If you don't have one, install OpenSSH or download it here (https://github.com/PowerShell/Win32-OpenSSH/releases)
    SSHExecutable: ssh

  Webui:
    # --host. Host to listen
    # [Use IPv6] '::'
    # [In most cases] Default to '0.0.0.0'
    WebuiHost: 0.0.0.0
    # --port. Port to listen
    # You will be able to access webui via `http://{host}:{port}`
    # [In most cases] Default to 22267
    WebuiPort: 22267
    # Language to use on web ui
    # 'zh-CN' for Chinese simplified
    # 'en-US' for English
    # 'ja-JP' for Japanese
    # 'zh-TW' for Chinese traditional
    Language: zh-CN
    # Theme of web ui
    # 'default' for light theme
    # 'dark' for dark theme
    Theme: default
    # Follow system DPI scaling
    # [In most cases] true
    # [In few cases] false to make Alas smaller, if you have a low resolution but high DPI scaling.
    DpiScaling: true
    # --key. Password of web ui
    # Useful when expose Alas to the public network
    Password: null
    # --cdn. Use jsdelivr cdn for pywebio static files (css, js).
    # 'true' for jsdelivr cdn
    # 'false' for self host cdn (automatically)
    # 'https://path.to.your/cdn' to use custom cdn
    CDN: false
    # --run. Auto-run specified config when startup
    # 'null' default no specified config
    # '["alas"]' specified "alas" config
    # '["alas","alas2"]' specified "alas" "alas2" configs
    Run: null
